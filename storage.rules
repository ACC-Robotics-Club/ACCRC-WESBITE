rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same admin list as firestore.rules: the "admins" Firestore collection.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Team submissions: Maximum 50MB file size, admins only
    match /fests/{festId}/teams/{teamId}/{filename} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // General assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
