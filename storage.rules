rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Uploaded files can carry malware and personal data. Only explicitly
    // authorized staff can manage them; public delivery is intentionally not
    // enabled until a reviewed, separate public-assets path is needed.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
