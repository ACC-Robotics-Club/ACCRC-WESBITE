rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Events: Public read, authenticated write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // News: Public read, authenticated write
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Achievements: Public read, authenticated write
    match /achievements/{achievementId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // Registrations: the public may create event registrations only.
    // Membership registrations are written by the /api/register Pages
    // Function (service account), which also issues the club ID.
    match /registrations/{regId} {
      allow create: if request.resource.data.type == 'event';
      allow read, update, delete: if request.auth != null;
    }
    
    // Leadership applications can be submitted only while the corresponding
    // portal toggle is open. Membership registrations remain always open.
    match /applications/{appId} {
      allow create: if exists(/databases/$(database)/documents/config/portal) && (
        (request.resource.data.type == 'executive' &&
          get(/databases/$(database)/documents/config/portal).data.execOpen == true) ||
        (request.resource.data.type == 'prefect' &&
          get(/databases/$(database)/documents/config/portal).data.prefectOpen == true) ||
        (request.resource.data.type == 'sub-executive' &&
          get(/databases/$(database)/documents/config/portal).data.subExecOpen == true)
      );
      allow read, update, delete: if request.auth != null;
    }
    
    // Club-ID counters: server-only (service account bypasses rules).
    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Config: Public read (for portal status), authenticated write
    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
