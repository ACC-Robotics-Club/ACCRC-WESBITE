rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are the accounts listed in the "admins" collection (document ID =
    // the account's Auth UID). Being signed in is not enough: anyone can
    // create a Firebase Auth account with the site's public API key.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin list: each account may check only its own entry. Admins are added
    // and removed in the Firebase console, never from the website.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Fest Global Settings & Launcher Toggles: Public read, Admin write
    match /fest_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    // Fest Segments & Competitions: Public read, Admin write
    match /fest_segments/{segmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fest Schedules: Public read, Admin write
    match /fest_schedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fest Announcements & Match Results: Public read, Admin write
    match /fest_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fest Registrations & Teams:
    // Anyone can create a team registration.
    // Public read so teams can retrieve their own pass by ID.
    // Kept readable for legacy registrations created before the canonical
    // registrations collection was introduced.
    match /fest_registrations/{regId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Regular Club Events: Public read, Admin write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // News & Announcements: Public read, Admin write
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Achievements: Public read, Admin write
    match /achievements/{achievementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Membership, event, and fest registrations. Fest entries are public only
    // for participant lookup; administrative mutations still require sign-in.
    match /registrations/{regId} {
      // New entries start unreviewed (fest teams send 'pending'); only admins
      // can mark one verified, accepted or rejected.
      allow create: if !('status' in request.resource.data) ||
        request.resource.data.status == 'pending';
      allow read: if isAdmin() || resource.data.type == 'fest';
      allow update, delete: if isAdmin();
    }

    // Leadership Applications (Executive, Prefect, Sub-Executive)
    match /applications/{appId} {
      // Applications arrive as 'pending'; only admins can accept or reject.
      allow create: if (!('status' in request.resource.data) ||
          request.resource.data.status == 'pending') &&
        exists(/databases/$(database)/documents/config/portal) && (
        (request.resource.data.type == 'executive' &&
          get(/databases/$(database)/documents/config/portal).data.execOpen == true) ||
        (request.resource.data.type == 'prefect' &&
          get(/databases/$(database)/documents/config/portal).data.prefectOpen == true) ||
        (request.resource.data.type == 'sub-executive' &&
          get(/databases/$(database)/documents/config/portal).data.subExecOpen == true)
      );
      allow read, update, delete: if isAdmin();
    }

    // Portal Config: Public read, Admin write
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
